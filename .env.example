ASPNETCORE_ENVIRONMENT=Development

# Firestore (emulador Compose: porta host 8085 → firestore:8080)
FIRESTORE_PROJECT_ID=local-autenticacao
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# dotnet run: use (default) com o emulador. GCP (parte 4): autenticacao
Firestore__ProjectId=local-autenticacao
Firestore__DatabaseId=(default)

# JWT RS256 — gere com ./scripts/setup-local-jwt.sh (preenche JWT_SIGNING_KEY_PEM)
JWT_ISSUER=autenticacao-service
JWT_AUDIENCE_FUNCIONARIO=funcionario
JWT_AUDIENCE_CLIENTE=cliente
JWT_KEY_ID=autenticacao-2026
JWT_SIGNING_KEY_PEM=

# Administrativo (mesmo SERVICE_AUTH_KEY do compose do administrativo)
# Compose api → host: http://host.docker.internal:8080
# dotnet run → http://localhost:8080
ADMINISTRATIVO_BASE_URL=http://localhost:8080
ServiceAuth__Key=local-service-auth-key-change-me
SERVICE_AUTH_KEY=local-service-auth-key-change-me

# PAT GitHub com read:packages (só para docker build / restore do building-blocks)
NUGET_AUTH_TOKEN=

DD_API_KEY=
DD_SITE=datadoghq.com
